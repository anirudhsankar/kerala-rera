# ---- Database ----
# PostgreSQL (production recommended)
# DATABASE_URL=postgresql+psycopg://rera:rera@localhost:5432/rera
# SQLite fallback (development / tests only)
DATABASE_URL=sqlite:///./data/rera.db

# ---- K-RERA source ----
RERA_BASE_URL=https://rera.kerala.gov.in

# ---- Polite request behaviour ----
RERA_REQUEST_DELAY_SECONDS=2
RERA_MAX_RETRIES=3
RERA_TIMEOUT_SECONDS=30
RERA_USER_AGENT=KeralaRERA-Intelligence/0.1 (+https://github.com/; research)

# ---- Storage ----
RAW_DATA_PATH=./data/raw
MANUAL_IMPORT_PATH=./data/raw/manual

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Parser ----
PARSER_VERSION=1.0.0
