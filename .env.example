# ---- Database ----
# PostgreSQL (production recommended)
# DATABASE_URL=postgresql+psycopg://rera:rera@localhost:5432/rera
# SQLite fallback (development / tests only)
DATABASE_URL=sqlite:///./data/rera.db

# ---- Read-only API ---------------------------------------------
# Least-privilege role used by the analytics API (falls back to DATABASE_URL).
READ_ONLY_DATABASE_URL=
# Comma-separated allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- K-RERA source ----
RERA_BASE_URL=https://rera.kerala.gov.in
# Optional public export URL for automated download (empty = manual file import).
# NOTE: the official endpoint https://rera.kerala.gov.in/export-projects is behind
# an anti-bot challenge and returns HTTP 503 to server-to-server requests, so it
# must be left EMPTY here. Set a URL only if you have a genuinely public endpoint
# that returns the file without a challenge.
RERA_EXPORT_URL=

# ---- Polite request behaviour ----
RERA_REQUEST_DELAY_SECONDS=2
RERA_MAX_RETRIES=3
RERA_TIMEOUT_SECONDS=30
RERA_USER_AGENT=KeralaRERA-Intelligence/0.1 (+https://github.com/; research)

# ---- Storage ----
RAW_DATA_PATH=./data/raw
MANUAL_IMPORT_PATH=./data/raw/manual

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Parser ----
PARSER_VERSION=1.0.0
